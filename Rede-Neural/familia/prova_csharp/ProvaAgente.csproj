<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Prova de conceito do agente da familia em C#, FORA da RegraDeCasamento.sln.
    Quando o Gerente tiver pasta propria (ARCHITECTURE.md, secao 9), estas
    classes mudam para la. Nenhum pacote NuGet: so o .NET.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProvaAgente</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>
</Project>
