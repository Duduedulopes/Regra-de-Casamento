@page "/cadastro"
@inject ApiDoApp Api
@inject Sessao Sessao
@inject NavigationManager Navegacao

<PageTitle>Cadastro · Regra de Casamento</PageTitle>

<MudPaper Class="pa-6" Elevation="1">
    <MudText Typo="Typo.h5" GutterBottom="true">Criar conta de adulto</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">Crianças não se cadastram: um adulto da família cria a conta delas.</MudText>

    <MudStack Spacing="3">
        <MudTextField @bind-Value="_email" Label="E-mail" InputType="InputType.Email" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="_senha" Label="Senha" InputType="InputType.Password" Variant="Variant.Outlined"
                      HelperText="6 ou mais caracteres, com maiúscula, minúscula, número e símbolo." />
        <MensagensDeErro Erros="_erros" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_enviando" OnClick="CadastrarAsync">Criar conta</MudButton>
        <MudText Typo="Typo.body2">Já tem conta? <MudLink Href="entrar">Entrar</MudLink></MudText>
    </MudStack>
</MudPaper>

@code {
    private string _email = "";
    private string _senha = "";
    private IReadOnlyList<string> _erros = [];
    private bool _enviando;

    private async Task CadastrarAsync()
    {
        _enviando = true;
        var resposta = await Api.CadastrarAsync(new DadosDeCadastro(_email, _senha));
        _enviando = false;
        _erros = resposta.Erros;

        if (resposta.DeuCerto)
        {
            await Sessao.RecarregarAsync();
            Navegacao.NavigateTo("comecar");
        }
    }
}
