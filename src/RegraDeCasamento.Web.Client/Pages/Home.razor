@page "/"
@inject Sessao Sessao
@inject NavigationManager Navegacao

<PageTitle>Regra de Casamento</PageTitle>

@if (_crianca)
{
    <MudPaper Class="pa-6" Elevation="1">
        <MudText Typo="Typo.h5" GutterBottom="true">Oi, @Sessao.NomeParaMostrar!</MudText>
        <MudText>Em breve, aqui ficam as suas tarefas, o horário de estudo e o ranking da família.</MudText>
    </MudPaper>
}
else
{
    <MudProgressCircular Indeterminate="true" />
}

@code {
    private bool _crianca;

    // A página inicial só decide para onde cada um vai.
    protected override async Task OnInitializedAsync()
    {
        var eu = await Sessao.ObterAsync();
        if (eu is null)
        {
            Navegacao.NavigateTo("entrar");
        }
        else if (eu.FamiliaId is null)
        {
            Navegacao.NavigateTo("comecar");
        }
        else if (eu.Perfil == PerfilDeAcesso.Adulto)
        {
            Navegacao.NavigateTo("familia");
        }
        else
        {
            _crianca = true;
        }
    }
}
